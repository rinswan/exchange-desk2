PORT=3000
# Folder for the SQLite database and uploaded files
DATA_DIR=./data
# Set to true when the site is served over HTTPS (recommended)
COOKIE_SECURE=false
# First Super Admin, created on first start only if there are no users yet.
# Leave blank to create the first account from the Sign up tab instead.
ADMIN_ID=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Allow open sign-up after the first account exists (new people get the User role)
ALLOW_SIGNUP=false
# Optional: enables the AI assistant for the Super Admin
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
